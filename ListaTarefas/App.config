<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Banco SQLite local: o arquivo é criado automaticamente na primeira execução,
         na mesma pasta do executável. Nenhuma credencial é necessária. -->
    <add name="ListaTarefasDb"
         connectionString="Data Source=listatarefas.db"
         providerName="Microsoft.Data.Sqlite" />
  </connectionStrings>
</configuration>
